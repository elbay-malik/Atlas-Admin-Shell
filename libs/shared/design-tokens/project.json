{
  "name": "shared-design-tokens",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/design-tokens/src",
  "projectType": "library",
  "tags": [
    "type:util",
    "scope:shared"
  ],
  "// targets": "to see all targets run: nx show project shared-design-tokens --web",
  "targets": {
    "build-tokens": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/src/generated"
      ],
      "inputs": [
        "{projectRoot}/tokens/**/*",
        "{projectRoot}/build-tokens.mjs"
      ],
      "options": {
        "command": "node libs/shared/design-tokens/build-tokens.mjs"
      }
    }
  }
}