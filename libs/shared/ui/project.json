{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "prefix": "ui",
  "projectType": "library",
  "tags": [
    "type:ui",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/shared/ui/ng-package.json",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/ui/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "configDir": "libs/shared/ui/.storybook",
        "browserTarget": "shared-ui:build-storybook",
        "compodoc": false,
        "experimentalZoneless": true,
        "tsConfig": "libs/shared/ui/.storybook/tsconfig.json",
        "styles": [
          "libs/shared/ui/.storybook/styles.css"
        ],
        "port": 4400
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": [
        "{options.outputDir}"
      ],
      "options": {
        "configDir": "libs/shared/ui/.storybook",
        "browserTarget": "shared-ui:build-storybook",
        "compodoc": false,
        "experimentalZoneless": true,
        "tsConfig": "libs/shared/ui/.storybook/tsconfig.json",
        "styles": [
          "libs/shared/ui/.storybook/styles.css"
        ],
        "outputDir": "dist/storybook/shared-ui"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-storybook"
      ],
      "options": {
        "command": "pnpm exec concurrently -k -s first -n SB,A11Y -c magenta,blue \"pnpm exec http-server dist/storybook/shared-ui -p 4400 -s --silent\" \"pnpm exec wait-on http://127.0.0.1:4400 && pnpm exec test-storybook --url http://127.0.0.1:4400 -c libs/shared/ui/.storybook --maxWorkers 2\""
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "continuous": true,
      "options": {
        "buildTarget": "shared-ui:build-storybook",
        "staticFilePath": "dist/storybook/shared-ui",
        "port": 4400,
        "spa": true
      }
    }
  },
  "// implicitDependencies": "Nx cannot see a CSS @import, so the dependency on the design tokens is invisible to the project graph. Without this edge a colour change is 'affected: nothing' and skips every axe, contrast and build gate that exists to judge it.",
  "implicitDependencies": [
    "shared-design-tokens"
  ]
}
