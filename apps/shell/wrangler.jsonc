{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The shell IS a page, so unmatched navigations fall back to index.html.
  // Assets-only for now; the edge BFF adds "main" + "run_worker_first" here.
  "name": "atlas-shell",
  "routes": [{ "pattern": "atlas.elbaymalik.com", "custom_domain": true }],
  "compatibility_date": "2026-09-05",
  // The edge BFF. run_worker_first scopes the Worker to /api/* ONLY, so every
  // other path is served by asset routing exactly as before — the SPA fallback
  // for deep links is untouched and those requests never invoke the Worker.
  "main": "../shell-bff/src/worker.ts",
  "assets": {
    "directory": "../../dist/apps/shell/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Serves index.html with a 200 for ANY unmatched path, not only navigations.
    // The shell owns client-side routes so it needs this, but be aware of the
    // trade-off when debugging: after a partial deploy a missing .js chunk comes
    // back as HTML with a 200 rather than a 404. That is why the remotes below
    // deliberately do NOT enable it.
    "not_found_handling": "single-page-application"
  },
  // Not secrets: a JWKS endpoint and the issuer it mints for are public. No
  // admin secret appears here and none ever reaches the edge.
  //
  // There is no ATLAS_JWT_AUDIENCE: this provider mints no `aud` claim, and
  // passing one to jose would reject every token. See verify.ts.
  "vars": {
    "ATLAS_JWKS_URL": "https://znphjikmxtijqhgsbkon.auth.eu-central-1.nhost.run/v1/.well-known/jwks.json",
    "ATLAS_JWT_ISSUER": "https://znphjikmxtijqhgsbkon.auth.eu-central-1.nhost.run/v1"
  }
}
