{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "shell",
  "sourceRoot": "apps/shell/src",
  "tags": [
    "type:app",
    "scope:shell"
  ],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation-v4:build",
      "defaultConfiguration": "production",
      "options": {
        "cacheExternalArtifacts": true
      },
      "configurations": {
        "production": {
          "target": "shell:esbuild:production"
        },
        "development": {
          "target": "shell:esbuild:development",
          "dev": true
        }
      }
    },
    "serve": {
      "executor": "@angular-architects/native-federation-v4:build",
      "options": {
        "target": "shell:serve-original:development",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      },
      "continuous": true
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "buildTarget": "shell:esbuild:development"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shell:build",
        "port": 4200,
        "staticFilePath": "dist/apps/shell/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/shell",
        "browser": "apps/shell/src/main.ts",
        "tsConfig": "apps/shell/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shell/public"
          }
        ],
        "styles": [
          "apps/shell/src/styles.css"
        ],
        "polyfills": [
          "es-module-shims"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "shell:esbuild:production"
        },
        "development": {
          "buildTarget": "shell:esbuild:development"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "apps/shell",
        "parallel": false,
        "commands": [
          "node ../../tools/apply-manifest.mjs ${ATLAS_ENV:-production}",
          "pnpm exec wrangler deploy"
        ]
      },
      "configurations": {
        "check": {
          "commands": [
            "pnpm exec wrangler deploy --dry-run"
          ]
        },
        "preview": {
          "commands": [
            "node ../../tools/apply-manifest.mjs ${ATLAS_ENV:-preview}",
            "pnpm exec wrangler versions upload"
          ]
        }
      }
    },
    "serve-worker": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "apps/shell",
        "command": "pnpm exec wrangler dev --config ../shell-bff/wrangler.dev.jsonc --port 4300 --ip 127.0.0.1"
      }
    },
    "lighthouse": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec concurrently -k -s first -n SERVE,LH -c magenta,blue \"pnpm exec nx run-many -t serve-static -p shell,iam,feature-flags,audit-logs\" \"pnpm exec wait-on http://localhost:4200 http://localhost:4201/remoteEntry.json http://localhost:4202/remoteEntry.json http://localhost:4203/remoteEntry.json && node tools/lighthouse/run.mjs --runs 3\""
      }
    }
  },
  "// implicitDependencies": "Nx cannot see a CSS @import, so the dependency on the design tokens is invisible to the project graph. Without this edge a colour change is 'affected: nothing' and skips every axe, contrast and build gate that exists to judge it.",
  "implicitDependencies": [
    "shell-bff",
    "shared-design-tokens"
  ]
}
