{
  "name": "iam",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "iam",
  "sourceRoot": "apps/iam/src",
  "tags": [
    "type:app",
    "scope:iam"
  ],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation-v4:build",
      "defaultConfiguration": "production",
      "options": {
        "cacheExternalArtifacts": true
      },
      "configurations": {
        "production": {
          "target": "iam:esbuild:production"
        },
        "development": {
          "target": "iam:esbuild:development",
          "dev": true
        }
      }
    },
    "serve": {
      "executor": "@angular-architects/native-federation-v4:build",
      "options": {
        "target": "iam:serve-original:development",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      },
      "continuous": true
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "buildTarget": "iam:esbuild:development"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "iam:build",
        "port": 4201,
        "staticFilePath": "dist/apps/iam/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/iam",
        "browser": "apps/iam/src/main.ts",
        "tsConfig": "apps/iam/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/iam/public"
          }
        ],
        "styles": [
          "apps/iam/src/styles.css"
        ],
        "polyfills": [
          "es-module-shims"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "iam:esbuild:production"
        },
        "development": {
          "buildTarget": "iam:esbuild:development"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "apps/iam",
        "command": "pnpm exec wrangler deploy"
      },
      "configurations": {
        "check": {
          "command": "pnpm exec wrangler deploy --dry-run"
        },
        "preview": {
          "command": "pnpm exec wrangler versions upload"
        }
      }
    }
  },
  "// implicitDependencies": "Nx cannot see a CSS @import, so the dependency on the design tokens is invisible to the project graph. Without this edge a colour change is 'affected: nothing' and skips every axe, contrast and build gate that exists to judge it.",
  "implicitDependencies": [
    "shared-design-tokens"
  ]
}
